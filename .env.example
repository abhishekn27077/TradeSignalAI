# ==============================================================================
# TradeSignalAI-v3 Safe Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# NEVER commit .env to source control.
# In production, provide these via secure environment variables or a vault.
# ==============================================================================

# Core Runtime Configuration
ENVIRONMENT=development
EXECUTION_MODE=DEMO
AUTO_TRADING_ENABLED=true
DEBUG=false
EMERGENCY_KILL_SWITCH=false
REAL_MONEY_ENABLED=false
BROKER_EXECUTION_ENABLED=false

# Security & JWT Authentication (Production requires a strong >=32 char secret)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
VALID_API_KEYS=[]

# Database & Persistence (Leave empty to use local development SQLite fallback)
DATABASE_URL=
REDIS_URL=
VECTOR_DB_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# AI & LLM Provider API Keys (Leave empty if not using cloud inference)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

GEMINI_API_KEY=

NVIDIA_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3-opus

# MetaTrader 5 (MT5) Integration (Real-money execution is locked by default)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Binance API Credentials
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# TradingView Integration
TV_USERNAME=
TV_PASSWORD=

# Networking & Security Controls
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
RATE_LIMIT_PER_MINUTE=60

# Risk Thresholds
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
MIN_AI_CONFIDENCE=0.65

# Hugging Face Suppressions
HF_HUB_DISABLE_WARNINGS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
