      "findings": [
        {
          "severity": "CRITICAL",
          "file": "app/execution/router.py",
          "issue": "SmartOrderRouter.execute_trade() calls broker.execute_order() but IBrokerAdapter only defines submit_order(). This will cause AttributeError at runtime if the coordinator route is used.",
          "fix": "Change execute_trade to call broker.submit_order with an ExecutionOrder object."
        },
        {
          "severity": "HIGH",
          "file": "app/api/v1/ws.py:177",
          "issue": "event_bus.publish('SymbolChanged', ...) is called without await. Since publish is async, this creates a coroutine that is never awaited, silently dropping the event.",
          "fix": "Add await: await event_bus.publish('SymbolChanged', {'symbol': topic})"
        },
        {
          "severity": "MEDIUM",
          "file": "app/execution/coordinator.py:100",
          "issue": "asyncio.create_task is called inside _on_consensus_completed but 'import asyncio' is at line 105, after the function definition. This will fail if the method is called before module-level code completes.",
          "fix": "Move 'import asyncio' to the top of the file."
        },
        {
          "severity": "HIGH",
          "file": "app/execution/coordinator.py:59-64",
          "issue": "BrokerFactory.create() is called with api_key/secret_key positional kwargs but the factory expects **kwargs. The TradingViewBrokerAdapter.__init__ also accepts **kwargs but ignores them. If coordinator.validate_and_execute is ever called, it creates a NEW broker each time instead of reusing the registered one.",
          "fix": "Coordinator should use smart_router's existing broker, not create new ones."
        },
        {
          "severity": "LOW",
          "file": "app/memory/manager.py:86-87",
          "issue": "_handle_trade_reviewed is subscribed to 'TradeReviewed' event but the handler body is 'pass'. No memory is actually generated from trade reviews.",
          "fix": "Implement the handler to create memory entries from trade reviews."
        },
        {
          "severity": "HIGH",
          "file": "app/analytics/engine.py:10",
          "issue": "AnalyticsEngine.calculate_statistics expects List[TradeRecord] with .pnl attribute, but JournalManager returns plain dicts. These are incompatible types.",
          "fix": "Make AnalyticsEngine accept dicts or convert dicts to TradeRecord in the caller."
        }
      ]
    },
